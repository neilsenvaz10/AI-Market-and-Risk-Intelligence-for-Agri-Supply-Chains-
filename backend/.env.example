# =====================================================================
# FASALYTICS Backend (Express) — copy to backend/.env and fill in.
# Never commit backend/.env. Secrets in this file stay on the server.
# =====================================================================

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
# On Windows, port 5000 is often reserved by the OS; the server then
# falls back to 5001 automatically (set VITE_API_URL to match).
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (and used for links in welcome emails)
FRONTEND_URL=http://localhost:5173

# FastAPI ML service
ML_SERVICE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fasalytics

# Optional: a full connection string overrides the DB_* values above
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fasalytics

# ---------------------------------------------------------------------
# Firebase Admin — verifies farmers' Firebase ID tokens (Phase 2)
# ---------------------------------------------------------------------
# REQUIRED: must be the SAME project as VITE_FIREBASE_PROJECT_ID in frontend/.env
# (Firebase Console > Project settings > General > Project ID)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional service account — NOT needed to verify ID tokens.
# Keep the JSON file OUTSIDE the repository and never commit it.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/secrets/fasalytics-firebase-adminsdk.json
# (GOOGLE_APPLICATION_CREDENTIALS is also accepted as the file path.)
# ...or inline fields instead of a file:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# DEVELOPMENT ONLY — trust tokens issued by the local Firebase Auth Emulator.
# Use with FIREBASE_PROJECT_ID=demo-fasalytics. Never set this in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------------
# Transactional email — welcome email after registration (optional)
# ---------------------------------------------------------------------
# Supported providers: resend | sendgrid.
# Leave unset to disable sending: deliveries are recorded as
# "not_configured" in PostgreSQL and retried automatically once configured.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The sender address must be on a domain verified with your provider:
# EMAIL_FROM=FASALYTICS <no-reply@your-verified-domain.in>
# EMAIL_REPLY_TO=support@your-verified-domain.in

# ---------------------------------------------------------------------
# Phase 3 - Mandi data pipeline (safe defaults: nothing runs, nothing synthetic is written)
# ---------------------------------------------------------------------
# Provider for scheduled/CLI runs: empty (none) | DATA_GOV_IN | CEDA
#   DATA_GOV_IN = data.gov.in "Current Daily Price of Various Commodities from Various
#                 Markets (Mandi)" (DMI, generated through AGMARKNET)
#   CEDA        = CEDA, Ashoka University Agmarknet data (historical, 2021-10-01..2026-09-30)
# MOCK generates SYNTHETIC prices for isolated tests only and is refused unless
# MANDI_ALLOW_SAMPLE_DATA=true (never honoured when NODE_ENV=production).
MANDI_DATA_PROVIDER=
MANDI_ALLOW_SAMPLE_DATA=false

# data.gov.in (Open Government Data Platform India). Register for a key at
# https://data.gov.in — the OGD API takes it as a query parameter; it is never logged.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# CEDA API (Bearer token). Register at https://api.ceda.ashoka.edu.in/
# Terms: non-commercial use with attribution to CEDA, Ashoka University.
CEDA_API_KEY=
CEDA_API_URL=https://api.ceda.ashoka.edu.in/v1
# Historical requests are split into windows of this many days (1-366)
CEDA_REQUEST_WINDOW_DAYS=92

# Scheduled current-price refresh (DATA_GOV_IN only). 0 = disabled.
# Whole numbers 15-10080 enable it; anything else (e.g. "5", "abc") keeps it disabled.
MANDI_SYNC_INTERVAL_MINUTES=0
# Days re-read on every run to pick up late reports (1-30)
MANDI_SYNC_LOOKBACK_DAYS=3
# A scheduled run is aborted after this many minutes (1-240)
MANDI_SYNC_JOB_TIMEOUT_MINUTES=30

# Source HTTP behaviour
MANDI_HTTP_TIMEOUT_MS=20000
MANDI_HTTP_RETRIES=3
MANDI_REQUEST_INTERVAL_MS=1000

# Historical export storage guard (ceda:export)
# MANDI_DATA_DIR=data/mandi
MANDI_MIN_FREE_DISK_GB=20
MANDI_DOWNLOAD_BUDGET_MB=500
