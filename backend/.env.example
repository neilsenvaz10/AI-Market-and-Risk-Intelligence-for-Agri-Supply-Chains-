# =====================================================================
# FASALYTICS Backend (Express) — copy to backend/.env and fill in.
# Never commit backend/.env. Secrets in this file stay on the server.
# =====================================================================

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
# On Windows, port 5000 is often reserved by the OS; the server then
# falls back to 5001 automatically (set VITE_API_URL to match).
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (and used for links in welcome emails)
FRONTEND_URL=http://localhost:5173

# FastAPI ML service
ML_SERVICE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fasalytics

# Optional: a full connection string overrides the DB_* values above
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fasalytics

# ---------------------------------------------------------------------
# Firebase Admin — verifies farmers' Firebase ID tokens (Phase 2)
# ---------------------------------------------------------------------
# REQUIRED: must be the SAME project as VITE_FIREBASE_PROJECT_ID in frontend/.env
# (Firebase Console > Project settings > General > Project ID)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional service account — NOT needed to verify ID tokens.
# Keep the JSON file OUTSIDE the repository and never commit it.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/secrets/fasalytics-firebase-adminsdk.json
# (GOOGLE_APPLICATION_CREDENTIALS is also accepted as the file path.)
# ...or inline fields instead of a file:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# DEVELOPMENT ONLY — trust tokens issued by the local Firebase Auth Emulator.
# Use with FIREBASE_PROJECT_ID=demo-fasalytics. Never set this in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------------
# Transactional email — welcome email after registration (optional)
# ---------------------------------------------------------------------
# Supported providers: resend | sendgrid.
# Leave unset to disable sending: deliveries are recorded as
# "not_configured" in PostgreSQL and retried automatically once configured.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The sender address must be on a domain verified with your provider:
# EMAIL_FROM=FASALYTICS <no-reply@your-verified-domain.in>
# EMAIL_REPLY_TO=support@your-verified-domain.in
